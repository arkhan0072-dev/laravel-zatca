{
    "name": "arkhan0072-dev/laravel-zatca",
    "description": "ZATCA (Fatoora) e-invoicing for Laravel: a concurrency-safe invoice chain, onboarding, and exactly-once reporting and clearance.",
    "type": "library",
    "keywords": ["laravel", "zatca", "fatoora", "e-invoicing", "saudi-arabia", "vat", "ubl"],
    "homepage": "https://github.com/arkhan0072-dev/laravel-zatca",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/arkhan0072-dev/laravel-zatca/issues",
        "source": "https://github.com/arkhan0072-dev/laravel-zatca"
    },
    "authors": [
        { "name": "Abdulrehman Khan", "homepage": "https://github.com/arkhan0072-dev", "role": "Developer" }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": { "Arkhan\\Zatca\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Arkhan\\Zatca\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": { "providers": ["Arkhan\\Zatca\\ZatcaServiceProvider"] }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
